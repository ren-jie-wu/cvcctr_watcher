# Poll every N minutes. Keep this respectful; 30-60 is a good range.
POLL_MINUTES=30

# Email settings. For Gmail, use an app password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
EMAIL_FROM=yourname@gmail.com
EMAIL_TO=yourname@gmail.com

# Optional
STATE_PATH=cvcctr_state.json
LOG_LEVEL=INFO
